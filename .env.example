# Bancos (docker compose)
POSTGRES_DB=usuarios
POSTGRES_USER=agendador
POSTGRES_PASSWORD=agendador
MONGO_USER=agendador
MONGO_PASSWORD=agendador

# Serviços (exportar no shell antes de rodar)
DB_URL=jdbc:postgresql://localhost:5432/usuarios
DB_USER=agendador
DB_PASSWORD=agendador
MONGO_URI=mongodb://agendador:agendador@localhost:27017/tarefas?authSource=admin
USUARIO_URL=http://localhost:8081
TAREFAS_URL=http://localhost:8082
# Mínimo 32 caracteres
JWT_SECRET=troque-esta-chave-por-uma-com-32-caracteres-ou-mais
JWT_EXPIRATION_MS=3600000
