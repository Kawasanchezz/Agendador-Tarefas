# Copie para .env e troque TODAS as senhas. Nunca versione o .env.

# Bancos (lidos pelo docker compose)
POSTGRES_DB=usuarios
POSTGRES_USER=agendador
POSTGRES_PASSWORD=troque-esta-senha
MONGO_USER=agendador
MONGO_PASSWORD=troque-esta-senha

# Serviços (carregue no shell antes de rodar: set -a; source .env; set +a)
# usuario
DB_URL=jdbc:postgresql://localhost:5432/usuarios
DB_USER=agendador
DB_PASSWORD=troque-esta-senha
# tarefas (use a mesma senha do MONGO_PASSWORD; caracteres especiais precisam de URL-encode)
MONGO_URI=mongodb://agendador:troque-esta-senha@localhost:27017/tarefas?authSource=admin
# bff
USUARIO_URL=http://localhost:8081
TAREFAS_URL=http://localhost:8082
# Mínimo 32 caracteres, aleatório. Ex.: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres
JWT_EXPIRATION_MS=3600000
