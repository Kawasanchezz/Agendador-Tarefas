#!/bin/sh
# Bloqueia commits com segredos. Ative com: git config core.hooksPath .githooks
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --no-banner || { echo "Possível segredo no commit."; exit 1; }
else
  echo "gitleaks não instalado: scan de segredos ignorado (https://github.com/gitleaks/gitleaks)." >&2
fi
